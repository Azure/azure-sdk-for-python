# EdgeActions SDK contributor tests.
# Copy to .env at the worktree root (three directories above this package).
# If .env already exists, merge these settings instead of overwriting it.
# Never commit .env or real credentials. Existing shell variables take precedence.
# Run pytest from the package directory, not the worktree root.

# Choose a mode by editing the two active assignments below:
#
# Mode                    AZURE_TEST_RUN_LIVE    AZURE_SKIP_LIVE_RECORDING
# Record                  true                   false
# Live without recording  true                   true
# Playback / offline      false                  ignored (either value)
#
# Record: calls Azure and saves HTTP recordings.
# Live without recording: calls Azure but saves no recordings.
# Playback: uses saved HTTP recordings without calling Azure.
# Offline unit tests use mocks and do not need recordings.
#
# Lifecycle tests support both recording and playback without editing Python files.
# Use the same pytest command for both modes; only these environment settings change.
# Playback requires usable recordings; missing or mismatched recordings fail the test.
# The two generated smoke tests remain live-only and are skipped during playback.
#
# Safe default: no Azure calls. To RECORD, change BOTH assignments to true/false.
AZURE_TEST_RUN_LIVE=false
AZURE_SKIP_LIVE_RECORDING=true

# AZURE_SKIP_LIVE_RECORDING is NOT a playback switch; it matters only when
# AZURE_TEST_RUN_LIVE=true. It has no effect on playback.
# If you previously set either variable with PowerShell $env:..., changing this
# file will not override it. Remove the shell override or open a fresh terminal.

# Required only for live/record runs; not needed for playback or offline tests.
# Replace with an authorized test subscription ID.
# Sign in with az login and select the intended account/subscription separately.
AZURE_SUBSCRIPTION_ID=<test-subscription-id>
AZURE_TEST_USE_CLI_AUTH=true
AZURE_TEST_USE_PWSH_AUTH=false
AZURE_TEST_USE_AZD_AUTH=false

# Live/record runs: leave unset to create isolated rgpy-pythonsdk-edgeaction-test-<suffix> groups.
# EdgeAction names are generated from the test identity and stay stable for playback.
# To reuse a dedicated group, uncomment and replace the value below.
# The group must already exist and will not be deleted by the test framework.
# Test-created EdgeActions inside the group are still targeted for cleanup.
# AZURE_RESOURCEGROUP_NAME=<existing-dedicated-test-rg>

# Optional service-principal authentication instead of Azure CLI authentication:
# set all AZURE_TEST_USE_*_AUTH flags above to false, then supply these locally.
# AZURE_TENANT_ID=<tenant-id>
# AZURE_CLIENT_ID=<application-client-id>
# AZURE_CLIENT_SECRET=<client-secret>
