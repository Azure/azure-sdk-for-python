# Rust build artifacts (anchored to this package)
/target/
/Cargo.lock
/azure/cosmos/*.pdb
/azure/cosmos/_rust*.so

# Local Clippy output
/bite52-clippy.txt

# Generated per-op parity audit docs and design scratch notes (the
# generator is checked in at scripts/v5/build_legacy_parity_audit.py;
# the rendered Markdown it writes into docs/V5/ is per-developer-run
# output and must not be committed).
/docs/V5/

# Workload credentials, including copies in nested workload folders.
# profiling_target.env contains no secrets and remains checked in.
/tests/workloads/**/*secrets.env

# Generated workload profiler captures, logs, reports, and run manifests.
/tests/workloads/**/artifacts/
/tests/workloads/**/logs/
