# Copy to ~/profiling_config.env and fill in the empty target values.
# This is a template, not an automatically loaded fallback. No credentials.
# Use literal assignments, not ${NAME:-default}; the file owns these settings.
export COSMOS_URI=""
export COSMOS_DATABASE=""
export COSMOS_CONTAINER=""
# Field supplying the partition-key value: id means path /id, not value test-42.
export COSMOS_PARTITION_KEY=id
export COSMOS_MAX_ITEM_INDEX=1000
export COSMOS_THROUGHPUT=1000
export COSMOS_PREFERRED_LOCATIONS="West US 2"
export COSMOS_CLIENT_EXCLUDED_LOCATIONS=""
export COSMOS_REQUEST_EXCLUDED_LOCATIONS=""
export COSMOS_USE_MULTIPLE_WRITABLE_LOCATIONS=false
export RESULTS_COSMOS_URI=""
export RESULTS_COSMOS_DATABASE=""
export RESULTS_COSMOS_CONTAINER=""
export WORKLOAD_NUM_CLIENTS=1
# Applies to send-and-wait mode; fixed-rate reads use WORKLOAD_MAX_INFLIGHT.
export COSMOS_CONCURRENT_REQUESTS=1
export WORKLOAD_ARRIVAL_RATE=250
export WORKLOAD_MAX_INFLIGHT=10000
export WORKLOAD_OPERATIONS=read
export COSMOS_REQUEST_TIMEOUT=30
export WORKLOAD_USE_SYNC=false
export WORKLOAD_USE_PROXY=false
export WORKLOAD_GC_FREEZE=false
export WORKLOAD_LOOP_LAG_MONITOR=false
export WORKLOAD_SKIP_CLOSE=false
export WORKLOAD_MIX=""
export WORKLOAD_DOC_PROFILE=default
export COSMOS_LOG_LEVEL=WARNING
export COSMOS_ENABLE_DIAGNOSTICS_LOGGING=false
export PERF_ENABLED=true
export PERF_REPORT_INTERVAL=60
