#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# The profiling target: which account, data, and load the point-read profiling
# session measures. Source this; do not run it.
#
# WHY THIS FILE EXISTS SEPARATELY FROM perf_env.sh: perf_env.sh carries the
# defaults for the larger scale and leak tests -- scale_db, 10,001 items,
# 100,000 RU/s. Those are the wrong values for profiling one point read. This
# file sets the profiling values and is sourced FIRST, so that perf_env.sh's fallback
# form, "${COSMOS_DATABASE:-scale_db}", finds the value already set and keeps
# it. Source them the other way round and the workload silently reads ids that
# were never seeded.
#
# It holds NO secrets, so it is checked in. Account keys live only in
# ~/perf_secrets.env, which is not.
#
# Every value uses "${VAR:-default}" so a deliberate one-off override still
# wins:
#     WORKLOAD_ARRIVAL_RATE=350 ./prepare_profiling_environment.sh
#
# To profile a different account, copy this file to ~/perf_target.env and edit
# it there; the profiling scripts prefer that copy when it exists.
# ---------------------------------------------------------------------------

# ---- Account under measurement --------------------------------------------
# West US 2, the same region as cosmos-profile-vm, so the measurement is of the
# SDK rather than of a cross-region network hop.
export COSMOS_URI="${COSMOS_URI:-https://profiling.documents.azure.com:443/}"

# ---- Probe data ------------------------------------------------------------
# A dedicated database/container so profiling never shares data with the scale
# or leak tests. Seeded by initial-setup.py via profiling_seed_probe_data.sh.
export COSMOS_DATABASE="${COSMOS_DATABASE:-lat_probe_db}"
export COSMOS_CONTAINER="${COSMOS_CONTAINER:-lat_probe_cont}"
# The partition key PATH. With "id", each item's partition key value is its own
# id ("test-42"), which is what makes every read single-partition.
export COSMOS_PARTITION_KEY="${COSMOS_PARTITION_KEY:-id}"
# Highest item-id SUFFIX, inclusive at both ends: 1000 means test-0 .. test-1000,
# so 1,001 items exist and initial-setup.py creates MAX_ITEM_INDEX + 1.
export COSMOS_MAX_ITEM_INDEX="${COSMOS_MAX_ITEM_INDEX:-1000}"
# 400 RU/s. A point read costs 1 RU, so 250 reads/s uses about 250 RU/s and
# stays under the budget. Raising the rate without raising this produces 429s,
# which measure the account's limit rather than the SDK.
export COSMOS_THROUGHPUT="${COSMOS_THROUGHPUT:-400}"
export COSMOS_PREFERRED_LOCATIONS="${COSMOS_PREFERRED_LOCATIONS:-West US 2}"

# ---- Load shape ------------------------------------------------------------
# One client, one request at a time, at a fixed 250 arrivals/s. The fixed rate
# is what keeps the question narrow: an unpaced loop would speed up as the SDK
# got faster and would exceed the RU budget.
export WORKLOAD_NUM_CLIENTS="${WORKLOAD_NUM_CLIENTS:-1}"
export COSMOS_CONCURRENT_REQUESTS="${COSMOS_CONCURRENT_REQUESTS:-1}"
export WORKLOAD_ARRIVAL_RATE="${WORKLOAD_ARRIVAL_RATE:-250}"
export WORKLOAD_OPERATIONS="${WORKLOAD_OPERATIONS:-read}"
export COSMOS_REQUEST_TIMEOUT="${COSMOS_REQUEST_TIMEOUT:-30}"
export WORKLOAD_MAX_INFLIGHT="${WORKLOAD_MAX_INFLIGHT:-10000}"
export WORKLOAD_USE_SYNC="${WORKLOAD_USE_SYNC:-false}"
export WORKLOAD_GC_FREEZE="${WORKLOAD_GC_FREEZE:-false}"
export WORKLOAD_LOOP_LAG_MONITOR="${WORKLOAD_LOOP_LAG_MONITOR:-true}"
# No proxy: a proxy would add latency that does not belong to the SDK.
export WORKLOAD_USE_PROXY="${WORKLOAD_USE_PROXY:-false}"
# Keep logging and diagnostics from adding CPU and file-I/O to the measured path.
export COSMOS_LOG_LEVEL="${COSMOS_LOG_LEVEL:-WARNING}"
export COSMOS_ENABLE_DIAGNOSTICS_LOGGING="${COSMOS_ENABLE_DIAGNOSTICS_LOGGING:-false}"
# Pin routing-affecting switches instead of inheriting values from another run.
export COSMOS_USE_MULTIPLE_WRITABLE_LOCATIONS="${COSMOS_USE_MULTIPLE_WRITABLE_LOCATIONS:-false}"
export COSMOS_CLIENT_EXCLUDED_LOCATIONS="${COSMOS_CLIENT_EXCLUDED_LOCATIONS:-}"
export COSMOS_REQUEST_EXCLUDED_LOCATIONS="${COSMOS_REQUEST_EXCLUDED_LOCATIONS:-}"
# Report every 60s so a short profiling capture still produces rows.
export PERF_REPORT_INTERVAL="${PERF_REPORT_INTERVAL:-60}"
