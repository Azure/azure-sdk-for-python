{
    "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "baseName": {
            "type": "string",
            "defaultValue": "[resourceGroup().name]",
            "metadata": {
                "description": "A distinct identifier used to derive the Foundry account and project names."
            }
        },
        "location": {
            "type": "string",
            "defaultValue": "[resourceGroup().location]",
            "metadata": {
                "description": "The location of the resource. By default, this is the same as the resource group."
            }
        },
        "tenantId": {
            "type": "string",
            "defaultValue": "[subscription().tenantId]",
            "metadata": {
                "description": "The tenant ID to which the application and resources belong."
            }
        },
        "testApplicationOid": {
            "type": "string",
            "metadata": {
                "description": "The client OID to grant Foundry User access to the test resources."
            }
        }
    },
    "variables": {
        "foundryAccountName": "[concat(toLower(parameters('baseName')), '-ai')]",
        "foundryProjectName": "[concat(toLower(parameters('baseName')), '-project')]",
        "foundryUserRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '53ca6127-db72-4b80-b1b0-d745d6d5456d')]"
    },
    "resources": [
        {
            "type": "Microsoft.CognitiveServices/accounts",
            "apiVersion": "2025-04-01-preview",
            "name": "[variables('foundryAccountName')]",
            "location": "[parameters('location')]",
            "kind": "AIServices",
            "sku": {
                "name": "S0"
            },
            "identity": {
                "type": "SystemAssigned"
            },
            "properties": {
                "customSubDomainName": "[toLower(variables('foundryAccountName'))]",
                "allowProjectManagement": true,
                "defaultProjectName": "[variables('foundryProjectName')]",
                "publicNetworkAccess": "Enabled"
            },
            "resources": [
                {
                    "type": "projects",
                    "apiVersion": "2025-04-01-preview",
                    "name": "[variables('foundryProjectName')]",
                    "location": "[parameters('location')]",
                    "identity": {
                        "type": "SystemAssigned"
                    },
                    "sku": {
                        "name": "S0"
                    },
                    "properties": {
                        "displayName": "[variables('foundryProjectName')]",
                        "description": "Foundry project used by the azure-ai-projects live voice-agents-realtime tests."
                    },
                    "dependsOn": [
                        "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName'))]"
                    ]
                }
            ]
        },
        {
            "type": "Microsoft.Authorization/roleAssignments",
            "apiVersion": "2022-04-01",
            "name": "[guid(resourceGroup().id, variables('foundryAccountName'), 'FoundryUser')]",
            "properties": {
                "roleDefinitionId": "[variables('foundryUserRoleDefinitionId')]",
                "principalId": "[parameters('testApplicationOid')]"
            },
            "dependsOn": [
                "[resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName'))]"
            ]
        }
    ],
    "outputs": {
        "FOUNDRY_PROJECT_ENDPOINT": {
            "type": "string",
            "value": "[concat(reference(resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName'))).endpoints['AI Foundry API'], 'api/projects/', variables('foundryProjectName'))]"
        },
        "FOUNDRY_PROJECT_API_KEY": {
            "type": "string",
            "value": "[listKeys(resourceId('Microsoft.CognitiveServices/accounts', variables('foundryAccountName')), '2025-04-01-preview').key1]"
        }
    }
}
