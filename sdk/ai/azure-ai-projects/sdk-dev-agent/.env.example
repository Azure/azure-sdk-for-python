# Copy this file to `.env` and fill in your values.
# `python-dotenv` loads it automatically when you run `python -m sdk_dev_agent.cli`.

# Azure AI Foundry project endpoint.
# Find it in the Foundry portal under your project's "Overview" page.
# Example: https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
FOUNDRY_PROJECT_ENDPOINT=

# Model deployment name to use for the orchestrator and all sub-agents.
# This is the deployment name from your Foundry project, e.g. "gpt-4o".
FOUNDRY_MODEL_NAME=gpt-4o

# Bing grounding connection ID. Used by the orchestrator and the Onboarding
# sub-agent for general web / docs lookups.
# Find it in the Foundry portal under your project's "Connections" tab.
# Format: /subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>/connections/<connection>
BING_PROJECT_CONNECTION_ID=

# GitHub MCP connection ID. Used by the Researcher and Triage sub-agents to
# read files, search code, and list PRs/issues across the Azure SDK repos.
# This is the name (or full resource ID) of a custom connection you create
# once in the Foundry portal that stores a GitHub Personal Access Token.
# See README.md → "Create the GitHub MCP connection" for step-by-step
# instructions (which PAT scopes to request, how to configure the custom
# connection's `Authorization: Bearer <PAT>` header, etc.).
GITHUB_MCP_CONNECTION_ID=
